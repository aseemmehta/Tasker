{
  "name": "tasker",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:time": "npm run dev -w apps/time",
    "dev:home": "npm run dev -w apps/home",
    "typecheck": "tsc -p apps/time && tsc -p apps/home",
    "build": "npm run build -w apps/home -w apps/time && node scripts/assemble.mjs"
  },
  "dependencies": { "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
